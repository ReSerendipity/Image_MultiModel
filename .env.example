# .env.example — 复制为 .env 后按需修改（.env 不要提交到 Git！）

# HuggingFace / ModelScope 离线模式（默认开，避免联网拉模型）
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
MODELSCOPE_OFFLINE=1

# ComfyUI 更新检查禁用
COMFYUI_DISABLE_UPDATE_CHECK=1

# 远程 ComfyUI 服务（如使用）的 API Token
# COMFYUI_API_TOKEN=sk-xxxxxxxxxxxxxxxx

# 其他自定义敏感配置
# SOME_SECRET_KEY=your_value_here

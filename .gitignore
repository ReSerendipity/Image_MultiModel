# Image MultiModel .gitignore

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg

# ── Virtual Environment ──────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── IDE ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.catpaw/

# ── Testing ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Data & Output ────────────────────────────────────────────
data/*.db
data/*.db-wal
data/*.db-shm
data/uploads/
data/cache/
outputs/
logs/

# ── Model Files (大文件不提交) ──────────────────────────────
*.safetensors
*.pt
*.bin
*.ckpt
*.gguf

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── SSL ─────────────────────────────────────────────────────
bin/cert.pem
bin/key.pem

# ── 临时文件（§5.2 清理）─────────────────────────────────────
*.txt
!requirements.txt
!requirements-lock.txt
!PRD.md
!MASTER_PLAN.md
!WEBAPP_GUIDE.md
!TEST_AUDIT_REPORT.md
!AUDIT_REPORT_2.0.md
!REMAINING_TASKS_REPORT.md
.trash/
pytest_out*.txt
gen*.txt
fp_out*.txt

# ── Checkpoints ─────────────────────────────────────────────
data/checkpoints/

# ── Docker ──────────────────────────────────────────────────
docker-compose.override.yml

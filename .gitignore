# Image MultiModel .gitignore

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg

# ── Virtual Environment ──────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── IDE ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.catpaw/
.trae/

# ── Testing ─────────────────────────────────────────────────
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/

# ── Data & Output ────────────────────────────────────────────
data/*.db
data/*.db-wal
data/*.db-shm
data/uploads/
data/cache/
outputs/
logs/

# ── Model Files (大文件不提交) ──────────────────────────────
*.safetensors
*.pt
*.bin
*.ckpt
*.gguf

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── SSL ─────────────────────────────────────────────────────
app/cert.pem
app/key.pem

# ── .env（P1-3: 敏感配置不提交）──────────────────────────────
.env

# ── 临时文件（§5.2 清理）─────────────────────────────────────
*.txt
!requirements.txt
!requirements-lock.txt
!examples/prompts.txt
.trash/
pytest_out*.txt
gen*.txt
fp_out*.txt

# ── Checkpoints ─────────────────────────────────────────────
data/checkpoints/

# ── Docker ──────────────────────────────────────────────────
docker-compose.override.yml

# Auto-captured screenshots (output of tests/capture-screenshots.js)
/screenshots/

# 水印签名密钥（仅本机，严禁入库/随包分发）
.watermark_key

# ── Hypothesis property-based testing ───────────────────────
.hypothesis/

# ── Jupyter notebooks checkpoints ───────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Coverage and profiling (扩展) ────────────────────────────
.coverage.*
.coverage.xml
htmlcov/
cover/
coverage/
*.prof
prof/*.prof

# ── Benchmark results ────────────────────────────────────────
perf/results/*.json
perf/results/*.html
!perf/results/.gitkeep

# ── Temporary build artifacts ────────────────────────────────
*.pyc
__pycache__/
dist/
build/
*.egg-info/

# Cloned learning repos (research reference only, not part of project)
references/

# Vendored Comfy inference kernel (独立内核项目源码，维持为其独立 git 仓库，不并入本仓库)
comfy_kernel/

# IDE/editor state & node test deps (audit 2026-08-17)
tests/node_modules/
.zcode/

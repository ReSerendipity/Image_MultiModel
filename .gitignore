# Image MultiModel .gitignore

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg

# ── Virtual Environment ──────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── IDE ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.catpaw/
.trae/

# AI 工具本地状态（记忆/计划，仅本地保留，不上远程）
.workbuddy-ai/
.zcode/

# AI 规范（仅本地保留，不上远程，家族统一约定）
AGENTS.md

# 内部/本地规则（仅本地保留，不上远程，避免暴露本地信息）
LOCAL_RULES.md

# ── Testing ─────────────────────────────────────────────────
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/

# ── Data & Output ────────────────────────────────────────────
data/*.db
data/*.db-wal
data/*.db-shm
data/uploads/
data/cache/
outputs/
logs/
backups/

# 本地独享文档（治理/分析报告，仅本地保留、不上远程，2026-09-02）
docs/

# ── Model Files (大文件不提交) ──────────────────────────────
*.safetensors
*.pt
*.bin
*.ckpt
*.gguf

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── SSL ─────────────────────────────────────────────────────
bin/cert.pem
bin/key.pem

# ── .env（P1-3: 敏感配置不提交）──────────────────────────────
.env

# ── Temporary files（§5.2 清理）─────────────────────────────────────
*.txt
!requirements.txt
!requirements-lock.txt
!examples/prompts.txt
!PRD.md
!MASTER_PLAN.md
!WEBAPP_GUIDE.md
!TEST_AUDIT_REPORT.md
!AUDIT_REPORT_2.0.md
!REMAINING_TASKS_REPORT.md
.trash/
pytest_out*.txt
gen*.txt
fp_out*.txt

# CI 修复交接日志（本地账本，不入库）
FIX_LOG.md

# ── Checkpoints ─────────────────────────────────────────────
data/checkpoints/

# ── Docker ──────────────────────────────────────────────────
docker-compose.override.yml

# Auto-captured screenshots (output of tests/capture-screenshots.js)
/screenshots/

# 水印签名密钥（仅本机，严禁入库/随包分发）
.watermark_key

# ── Hypothesis property-based testing ───────────────────────
.hypothesis/

# ── Jupyter notebooks checkpoints ───────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Coverage and profiling (扩展) ────────────────────────────
.coverage.*
.coverage.xml
htmlcov/
cover/
coverage/
*.prof
prof/*.prof

# ── Benchmark results ────────────────────────────────────────
perf/results/*.json
perf/results/*.html
!perf/results/.gitkeep

# ── Temporary build artifacts ────────────────────────────────
*.pyc
__pycache__/
dist/
build/
*.egg-info/

# Cloned learning repos (research reference only, not part of project)
references/

# Vendored Comfy inference kernel (独立内核项目源码，维持为其独立 git 仓库，不并入本仓库)
comfy_kernel/
